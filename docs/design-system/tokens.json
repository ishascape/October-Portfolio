        "$type": "shadow",
        "$value": [
          {
            "color": "#1c1b1914",
            "offsetX": "0px",
            "offsetY": "1px",
            "blur": "0px",
            "spread": "0px"
          },
          {
            "color": "#1c1b1959",
            "offsetX": "0px",
            "offsetY": "14px",
            "blur": "24px",
            "spread": "-14px"
          }
        ]
      },
      "paper-hover": {
        "$type": "shadow",
        "$value": [
          {
            "color": "#1c1b1914",
            "offsetX": "0px",
            "offsetY": "1px",
            "blur": "0px",
            "spread": "0px"
          },
          {
            "color": "#1c1b1980",
            "offsetX": "0px",
            "offsetY": "20px",
            "blur": "30px",
            "spread": "-14px"
          }
        ]
      },
      "paper-lifted": {
        "$type": "shadow",
        "$value": [
