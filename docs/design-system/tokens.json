      "easing": {
        "pen": {
          "$type": "cubicBezier",
          "$value": [
            0.2,
            0,
            0,
            1
          ]
        },
        "settle": {
          "$type": "cubicBezier",
          "$value": [
            0.2,
            0.7,
            0.2,
            1
          ]
        },
        "enter": {
          "$type": "cubicBezier",
          "$value": [
            0.2,
            0.8,
            0.2,
            1
          ]
        },
        "glide": {
          "$type": "cubicBezier",
          "$value": [
            0.5,
            0,
            0.2,
            1
          ]
        }
